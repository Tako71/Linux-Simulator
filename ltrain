#!/usr/bin/env bash
# Запуск тренажёра Linux. Использование: ./ltrain [start|shell|stop|restart|reset|rebuild|status]
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$(command -v python3 || true)"
if [ -z "$PY" ]; then
  echo "Нужен python3 (на macOS: brew install python)" >&2
  exit 1
fi
cd "$DIR"
exec "$PY" -m trainer.launcher "$@"
